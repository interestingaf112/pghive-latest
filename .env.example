# ============================================
# PG wala — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Firebase Configuration (required for Cloud Mode) ---
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local Mode Admin Credentials ---
# Used ONLY when Firebase is not configured (offline/dev mode).
# If these are not set, admin login will be disabled in Local Mode.
VITE_ADMIN_USER=
VITE_ADMIN_PASS=

# --- Credit System HMAC Secret ---
# Used to sign credit balances in Local Mode to prevent tampering.
# Generate a random string: openssl rand -hex 32
VITE_CREDIT_SECRET=change_this_to_a_random_secret_string

# --- Razorpay Credentials (Optional) ---
# Used for processing test payments in frontend mode.
# Public key (exposed to client)
VITE_RAZORPAY_KEY_ID=
# Secret key (never exposed to client)
RAZORPAY_KEY_SECRET=

