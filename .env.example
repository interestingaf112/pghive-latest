# ============================================
# PG wala — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Firebase Configuration (required for Cloud Mode) ---
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local Mode Admin Credentials ---
# Used ONLY when Firebase is not configured (offline/dev mode).
# IMPORTANT: Use strong, unique credentials. Never use 'admin'/'password123'.
VITE_ADMIN_USER=
VITE_ADMIN_PASS=

# --- Razorpay Credentials ---
# Public key (safe for client bundle)
VITE_RAZORPAY_KEY_ID=

# Secret key — SERVER-SIDE ONLY, set in Vercel Dashboard > Environment Variables.
# WARNING: NEVER prefix with VITE_ — it would be bundled into the client JS.
# RAZORPAY_KEY_SECRET=  ← Vercel Dashboard only

# --- Firebase Admin SDK (SERVER-SIDE ONLY) ---
# Required for payment verification API route.
# Set FIREBASE_SERVICE_ACCOUNT_KEY in Vercel Dashboard (JSON stringified).
# See setup instructions in the project README.
